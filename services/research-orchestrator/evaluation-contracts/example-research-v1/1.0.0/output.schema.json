{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "score": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "score",
    "passed",
    "contract_digest"
  ],
  "type": "object"
}
