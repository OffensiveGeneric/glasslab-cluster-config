# AutoResearch GPU image for the Glasslab cluster
# Modeled on services/runner/Dockerfile.gpu: CUDA 12.4 base + cu124 torch wheel.
# Adds git, uv, and the AutoResearch repo. The FA3->SDPA patch for pre-Hopper
# GPUs is applied at job runtime (see the Job YAML), not baked in here.
FROM nvidia/cuda:12.4.1-base-ubuntu22.04

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/root/.local/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

RUN git clone https://github.com/karpathy/autoresearch.git /app/autoresearch

WORKDIR /app/autoresearch

RUN pip3 install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cu124 \
        torch

RUN uv sync --inexact || uv sync

CMD ["python3", "-c", "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"]
